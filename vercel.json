{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "buildCommand":"npm run build:vercel",
  "installCommand":"npm ci",
  "outputDirectory":"public",
  "regions":["fra1"],
  "functions":{"api/realtime.js":{"maxDuration":300},"api/**/*.js":{"maxDuration":15}},
  "rewrites":[{"source":"/health","destination":"/api/health"}],
  "headers":[
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Permissions-Policy","value":"fullscreen=*, gamepad=*"}]},
    {"source":"/","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/game-:hash.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
  ]
}
